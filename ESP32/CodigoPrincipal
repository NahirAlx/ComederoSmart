unsigned long obtenerPesoCeldaCarga(int cajon) {
  float pesoActual = 0;
  // Verifica si el cajón corresponde a la balanza izquierda o derecha
  if (cajon == platoIzquierdo) {
    pesoActual = balanzaIzquierda.get_units(1);
    pesoActual = Leaky(pesoActual);
    if (pesoActual < 0) {
      pesoActual = 0;
    }
  } else if (cajon == platoDerecho) {
    pesoActual = balanzaDerecha.get_units(1);
    pesoActual = Leaky(pesoActual);
    if (pesoActual < 0) {
      pesoActual = 0;
    }
  } else {
    // Si el cajón no es válido, devuelve 0 como peso por defecto
    return 0;
  }
  return (unsigned long)round(pesoActual);
}


