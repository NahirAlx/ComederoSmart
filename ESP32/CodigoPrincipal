int leerCeldaHORA(const String &rango) {
  FirebaseJson response;
  if (GSheet.values.get(&response, spreadsheetId, rango.c_str())) {  // Rango directo
    FirebaseJsonData jsonData;
    response.get(jsonData, "values");  // Obtener el array "values"
    if (jsonData.success) {
      FirebaseJsonArray valuesArray;
      jsonData.getArray(valuesArray);  // Obtener el array de valores
      if (valuesArray.size() > 0) {
        FirebaseJsonData firstValue;
        valuesArray.get(firstValue, 0);  // Obtener el primer elemento del array
        if (firstValue.success) {
          // Limpiar el valor para obtener solo la hora
          String valueStr = firstValue.stringValue;
          valueStr.replace("[", "");   // Eliminar [
          valueStr.replace("]", "");   // Eliminar ]
          valueStr.replace("\"", "");  // Eliminar comillas

          // Convertir la hora en formato HH:MM a total de segundos
          int horas = valueStr.substring(0, 2).toInt();
          int minutos = valueStr.substring(3, 5).toInt();
          int totalSegundos = (horas * 3600) + (minutos * 60);  // Cambiar totalMinutos a totalSegundos

          // Limpiar JSON
          response.clear();
          jsonData.clear();
          valuesArray.clear();
          return totalSegundos;  // Devolver el valor en segundos
        }
      }
    }
  } else {
    Serial.println(GSheet.errorReason());  // Mostrar error si no se pudo leer
  }
  response.clear();
  return 0;  // Devolver 0 si no se pudo leer
}

