//////////////   Funciones para el cajón izquierdo
void avanzarMotorIzquierdo() {
  // Ponemos ambos pines de dirección en el mismo estado (HIGH o LOW) para frenar
  digitalWrite(IN3_izq, HIGH);
  digitalWrite(IN4_izq, LOW);
  int pmw = 150;
  for (pmw; pmw >= 80; pmw = pmw - 30) {
    analogWrite(ENB, pmw);
    delay(100);
  }
}

void retrocederMotorIzquierdo() {
  digitalWrite(IN3_izq, LOW);
  digitalWrite(IN4_izq, HIGH);
  // analogWrite(ENB, 160);
  int pmw = 150;
  for (pmw; pmw >= 80; pmw = pmw - 30) {
    analogWrite(ENB, pmw);
    delay(100);
  }
}

void frenarMotorIzquierdo() {
  digitalWrite(IN3_izq, HIGH);
  digitalWrite(IN4_izq, HIGH);
  analogWrite(ENB, 0);
}

