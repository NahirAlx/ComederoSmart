    if (digitalRead(FC_adentro_izq) != LOW) {
      DEBUG_PRINTLN("Cerrando cajón izquierdo...");
      retrocederMotorIzquierdo();
      while (digitalRead(FC_adentro_izq) == HIGH) {
        delay(100);
      }
      frenarMotorIzquierdo();
    }
  }
}


