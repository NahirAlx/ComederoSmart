// Función para obtener la hora actual en segundos desde medianoche
unsigned long obtenerHoraActualEnSegundos() {
  struct tm timeinfo;
  // Obtén el tiempo local
  if (!getLocalTime(&timeinfo, 5000)) {
    Serial.println("No se pudo obtener la hora");
    return 0;  // Devuelve 0 si no se puede obtener la hora
  }
  // Calcula y devuelve los segundos desde medianoche
  return timeinfo.tm_hour * 3600 + timeinfo.tm_min * 60 + timeinfo.tm_sec;
}

void obtenerHoraActual() {
  configTime(gmtOffset_sec, daylightOffset_sec, ntpServer);
  // Espera a que el tiempo esté disponible
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo, 5000)) {
    Serial.println("No se pudo obtener la hora");
    return;
  }
  // Mostrar la hora actual
  Serial.print("Hora actual: ");
  Serial.print(timeinfo.tm_hour);
  Serial.print(":");
  Serial.print(timeinfo.tm_min);
  Serial.print(":");
  Serial.println(timeinfo.tm_sec);
}

void reconnectWiFi() {
  // Intenta reconectar al WiFi
  WiFi.disconnect();
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 10) {  // Límite de intentos
    delay(1000);
    Serial.print(".");
    attempts++;
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nReconectado a WiFi!");
  } else {
    Serial.println("\nNo se pudo reconectar a WiFi.");
  }
}

