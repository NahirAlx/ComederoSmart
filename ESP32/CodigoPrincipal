void prepararComida(int cajon, int i) {
  String nivelAlimento;
  // Leer el nivel de alimento según el cajón
  if (cajon == platoIzquierdo) {
    nivelAlimento = leerCeldaTexto("Uno!F2");
  } else if (cajon == platoDerecho) {
    nivelAlimento = leerCeldaTexto("Uno!F3");
  }
  // Verificar si el nivel de alimento es bajo
  if (nivelAlimento == "Bajo") {
    Serial.println("Alerta: Nivel de alimento bajo. No se puede preparar comida.");
    return;
  }

  // Comprobación de si el cajón está en la posición "adentro"
  if ((cajon == platoIzquierdo && digitalRead(FC_adentro_izq) == LOW) || (cajon == platoDerecho && digitalRead(FC_adentro_der) == LOW)) {
    // Obtener el peso inicial en la celda de carga y la porción esperada
    unsigned long pesoInicial = obtenerPesoCeldaCarga(cajon);
    unsigned long porcion = (cajon == platoIzquierdo ? porcionesIzquierdo[i] : porcionesDerecho[i]);
    unsigned long pesoDispensado = 0;  // Peso acumulado dispensado

    DEBUG_PRINT("Peso inicial: ");
    DEBUG_PRINTLN(pesoInicial);

    // Dispensar hasta alcanzar la porción deseada
    while ((pesoInicial + pesoDispensado) < porcion) {
      if (cajon == platoIzquierdo) {
        stepper_izq.step(-0.25 * stepsPerRevolution);
      } else {
        stepper_der.step(-0.25 * stepsPerRevolution);
      }
      // delay(200);

      // Actualizar el peso dispensado
      unsigned long pesoActual = obtenerPesoCeldaCarga(cajon);
      pesoDispensado = pesoActual - pesoInicial;
      DEBUG_PRINT("Peso dispensado: ");
      DEBUG_PRINTLN(pesoDispensado);
    }

    // Calcular el sobrante acumulado después de dispensar
    unsigned long sobrante = (pesoInicial + pesoDispensado) - porcion;

    // Actualizar el estado del cajón y el sobrante
    if (cajon == platoIzquierdo) {
      sobranteIzq += sobrante;      // Acumular sobrante para el plato izquierdo
      comidaListaIzquierdo = true;  // Indicar que la comida está lista
      Serial.println("Comida lista izq.");

    } else if (cajon == platoDerecho) {
      sobranteDer += sobrante;    // Acumular sobrante para el plato derecho
      comidaListaDerecho = true;  // Indicar que la comida está lista
    }
  } else {
    Serial.print("Error: Cajón no está 'adentro' para el plato ");
    Serial.println(cajon == platoIzquierdo ? "izquierdo" : "derecho");
    return;
  }
}

